# ==========================================
# CitCat Telegram Bot - Environment Configuration
# ==========================================

# Token bot dari @BotFather di Telegram (Wajib)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (Bisa didapat gratis di https://aistudio.google.com/)
# TIPS MULTI-KEY ANTI-LIMIT: Masukkan hingga 4 API key dipisahkan koma (,)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Opsional, untuk model Hermes 3, Gemma, Qwen, Nemotron)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Telegram User ID untuk Akses Admin & Hermes Self-Healing (Opsional, atau gunakan /setadmin di chat)
ADMIN_USER_ID=your_telegram_chat_id_here

